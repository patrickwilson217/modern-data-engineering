# Normalize text files to LF
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.parquet binary
*.png binary
*.jpg binary
*.pdf binary